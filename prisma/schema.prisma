// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id // email address
  passwordHash  String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  goals            Goal[]
  events           Event[]
  providers        Provider[]
  chatHistories    ChatHistory[]
  icsSubscriptions IcsSubscription[]
  memories         Memory[]
  searchConfig     SearchConfig?
}

model SearchConfig {
  id                   String   @id @default(uuid())
  userId               String   @unique
  searchProvider       String   @default("google") // "google" | "tavily"
  googleApiKey         String?
  googleSearchEngineId String?
  tavilyApiKey         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Goal {
  id            String          @id @default(uuid())
  userId        String
  title         String
  description   String
  dueDate       String?         // ISO datetime string or null
  chatHistoryId String?         @unique // FK to ChatHistory (1:1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatHistory   ChatHistory?    @relation(fields: [chatHistoryId], references: [id], onDelete: SetNull)
  events        Event[]
  infoTags      InfoTag[]

  @@index([userId])
}

model InfoTag {
  id        String   @id @default(uuid())
  goalId    String
  title     String
  info      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model Event {
  id              String   @id @default(uuid())
  userId          String
  goalId          String?  // nullable — links to Goal if it's a goal task
  title           String
  start           String   // ISO datetime string
  end             String   // ISO datetime string
  kind            String?  // 'task', 'break', 'ics', etc.
  completed       Boolean  @default(false)
  confirmed       Boolean  @default(true) // Whether user confirmed this event (AI-proposed tasks start as false)
  minutesEstimate Int?
  order           Int      @default(0)
  metadata        String?  // JSON string for extensibility

  // ICS-specific fields (nullable for user-created events)
  subscriptionId   String?          // Links to IcsSubscription if this is an ICS event
  uid              String?          // ICS UID field (unique per subscription)
  recurid          String           @default("") // RECURRENCE-ID: "" = master event, ISO string = modified occurrence
  description      String?          // DESCRIPTION (also useful for user events)
  location         String?          // LOCATION
  startTimezone    String?          // Timezone of DTSTART
  endTimezone      String?          // Timezone of DTEND
  isAllDay         Boolean          @default(false)
  status           String?          // STATUS (CONFIRMED, TENTATIVE, CANCELLED)
  organizer        String?          // ORGANIZER
  recurrenceRule   String?          // RRULE as raw string
  exdates          String?          // JSON array of ISO date strings to exclude from recurrence expansion
  transparency     String?          // TRANSP (TRANSPARENT/OPAQUE)
  categories       String?          // CATEGORIES as JSON array string
  url              String?          // URL
  rawData          String?          // Full raw ICS VEVENT data as JSON

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal             Goal?             @relation(fields: [goalId], references: [id], onDelete: Cascade)
  subscription     IcsSubscription?  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, uid, recurid])
  @@index([userId])
  @@index([goalId])
  @@index([subscriptionId])
}

model Provider {
  id        String   @id @default(uuid())
  userId    String
  type      String   // "anthropic" | "openai" | "google" | "mistral" | "cohere" | "openai-compatible"
  name      String   // User-friendly label, e.g. "My Ollama", "Anthropic"
  baseUrl   String?  // null = use SDK default; set for self-hosted
  apiKey    String   // API key for the provider
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  models        AIModel[]
  chatHistories ChatHistory[]

  @@index([userId])
}

model AIModel {
  id         String   @id @default(uuid())
  providerId String
  modelId    String   // SDK model identifier, e.g. "claude-sonnet-4-5-20250929", "gpt-4o"
  name       String   // Display name, e.g. "Claude Sonnet 4.5"
  isDefault  Boolean  @default(false) // User's default model for this provider
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

enum ChatHistoryRole {
  GoalPlanner
  Assistant
}

model ChatHistory {
  id         String           @id @default(uuid())
  userId     String
  title      String           @default("Untitled Chat")
  role       ChatHistoryRole  // Determines system prompt and available tools
  providerId String?          // nullable FK — which provider was used
  modelId    String?          // model identifier used for this chat
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  Provider?  @relation(fields: [providerId], references: [id], onDelete: SetNull)
  messages  Message[]
  goal      Goal?      // back-relation for 1:1

  @@index([userId])
  @@index([providerId])
}

model Message {
  id            String   @id @default(uuid())
  chatHistoryId String
  role          String   // 'user', 'assistant', 'system'
  content       String   // JSON — full AI SDK message payload
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  chatHistory   ChatHistory @relation(fields: [chatHistoryId], references: [id], onDelete: Cascade)

  @@index([chatHistoryId])
}

model Memory {
  id        String   @id @default(uuid())
  userId    String
  question  String   // The key question, e.g. "What is your occupation?"
  answer    String   // The user's answer/characteristic
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IcsSubscription {
  id          String     @id @default(uuid())
  userId      String
  name        String     // User-friendly label, e.g. "Work Calendar"
  url         String     // The secret ICS URL
  lastSynced  DateTime?  // When last successfully synced
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  events      Event[]

  @@index([userId])
}
