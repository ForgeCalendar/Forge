// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id // email address
  passwordHash  String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  goals          Goal[]
  events         Event[]
  aiAgentApiKeys AIAgentApiKey[]
  chatHistories  ChatHistory[]
}

model Goal {
  id            String          @id @default(uuid())
  userId        String
  title         String
  description   String
  dueDate       String?         // ISO datetime string or null
  chatHistoryId String?         @unique // FK to ChatHistory (1:1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatHistory   ChatHistory?    @relation(fields: [chatHistoryId], references: [id], onDelete: SetNull)
  events        Event[]
  infoTags      InfoTag[]

  @@index([userId])
}

model InfoTag {
  id        String   @id @default(uuid())
  goalId    String
  title     String
  info      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model Event {
  id              String   @id @default(uuid())
  userId          String
  goalId          String?  // nullable — links to Goal if it's a goal task
  title           String
  start           String   // ISO datetime string
  end             String   // ISO datetime string
  kind            String?  // 'task', 'break', etc.
  completed       Boolean  @default(false)
  minutesEstimate Int?
  order           Int      @default(0)
  metadata        String?  // JSON string for extensibility
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal            Goal?    @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([goalId])
}

enum AIProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  MISTRAL
  COHERE
}

model AIAgentApiKey {
  id        String     @id @default(uuid())
  userId    String
  provider  AIProvider
  apiKey    String     // Encrypted API key
  name      String?    // Optional friendly name for the key
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatHistories ChatHistory[]

  @@index([userId])
  @@unique([userId, provider])
}

model ChatHistory {
  id        String   @id @default(uuid())
  userId    String
  apiKeyId  String?  // nullable FK — which API key/provider was used
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey    AIAgentApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  messages  Message[]
  goal      Goal?         // back-relation for 1:1

  @@index([userId])
  @@index([apiKeyId])
}

model Message {
  id            String   @id @default(uuid())
  chatHistoryId String
  role          String   // 'user', 'assistant', 'system'
  content       String   // JSON — full AI SDK message payload
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  chatHistory   ChatHistory @relation(fields: [chatHistoryId], references: [id], onDelete: Cascade)

  @@index([chatHistoryId])
}
