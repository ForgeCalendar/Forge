// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id // email address
  passwordHash  String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  goals            Goal[]
  events           Event[]
  aiAgentApiKeys   AIAgentApiKey[]
  icsSubscriptions IcsSubscription[]
}

model Goal {
  id           String          @id @default(uuid())
  userId       String
  title        String
  description  String
  dueDate      String?         // ISO datetime string or null
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events       Event[]
  infoTags     InfoTag[]

  @@index([userId])
}

model InfoTag {
  id        String   @id @default(uuid())
  goalId    String
  title     String
  info      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model Event {
  id              String   @id @default(uuid())
  userId          String
  goalId          String?  // nullable — links to Goal if it's a goal task
  title           String
  start           String   // ISO datetime string
  end             String   // ISO datetime string
  kind            String?  // 'task', 'break', etc.
  completed       Boolean  @default(false)
  minutesEstimate Int?
  order           Int      @default(0)
  metadata        String?  // JSON string for extensibility
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal            Goal?    @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([goalId])
}

enum AIProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  MISTRAL
  COHERE
}

model AIAgentApiKey {
  id        String     @id @default(uuid())
  userId    String
  provider  AIProvider
  apiKey    String     // Encrypted API key
  name      String?    // Optional friendly name for the key
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, provider])
}

model IcsSubscription {
  id          String     @id @default(uuid())
  userId      String
  name        String     // User-friendly label, e.g. "Work Calendar"
  url         String     // The secret ICS URL
  lastSynced  DateTime?  // When last successfully synced
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  icsEvents   IcsEvent[]

  @@index([userId])
}

model IcsEvent {
  id               String          @id @default(uuid())
  subscriptionId   String
  uid              String          // ICS UID field (unique per subscription)
  summary          String?         // SUMMARY
  description      String?         // DESCRIPTION
  location         String?         // LOCATION
  start            String          // DTSTART as ISO string
  end              String?         // DTEND as ISO string
  startTimezone    String?         // Timezone of DTSTART
  endTimezone      String?         // Timezone of DTEND
  isAllDay         Boolean         @default(false)
  status           String?         // STATUS (CONFIRMED, TENTATIVE, CANCELLED)
  organizer        String?         // ORGANIZER
  recurrenceRule   String?         // RRULE as raw string
  transparency     String?         // TRANSP (TRANSPARENT/OPAQUE)
  categories       String?         // CATEGORIES as JSON array string
  url              String?         // URL
  rawData          String?         // Full raw ICS VEVENT data as JSON for extensibility
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  subscription     IcsSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, uid])
  @@index([subscriptionId])
}
